{
  "name": "isle-voip-overlay",
  "private": true,
  "version": "0.2.10",
  "description": "IsleVOIP proximity voice for The Isle",
  "author": "IsleVOIP",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit --pretty false && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && npx electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/dom-mediacapture-transform": "^0.1.11",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.4.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.isle-voip.overlay",
    "productName": "IsleVOIP",
    "protocols": [
      {
        "name": "IsleVOIP",
        "schemes": [
          "isle-voip"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "win": {
      "publisherName": "IsleVOIP",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "IsleVOIP-Setup-${version}.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Proximity voice for The Isle",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IsleVOIP-${version}.AppImage"
    },
    "copyright": "IsleVOIP",
    "publish": [
      {
        "provider": "generic",
        "url": "https://voip.islepilot.eu/launchers/feed/main/"
      }
    ]
  }
}
